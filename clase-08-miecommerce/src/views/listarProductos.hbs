<div class="container mt-5">
  <h1>{{titulo}}</h1>
  <div class="row mt-4">

    {{#each productos}}
    <div class="col-md-4 mb-4">
      <div class="card h-100">
        <img src="{{this.imagen}}" class="card-img-top" alt="{{this.nombre}}">
        <div class="card-body">
          <h5 class="card-title">{{this.nombre}}</h5>
          <p class="card-text">{{this.descripcion}}</p>
          <h6 class="card-subtitle mb-2">${{this.precio}}</h6> 
        </div>
        <div class="card-footer bg-white">

          <a href="/api/productos/detalleProducto/{{this._id}}" class="btn btn-primary btn-sm">Ver Detalles</a>
{{!--           <button class="btn btn-success btn-sm" onclick="agregarAlCarrito('{{this._id}}')">
            Agregar al Carrito
          </button> --}}

          <button class="btn btn-success btn-sm" id="carrito">
            Agregar al Carrito
          </button>
        </div>
      </div>
    </div>
    {{/each}}
  </div>
{{!--  {{#if productos.length == 0}}
  <div class="alert alert-info">
    No hay productos disponibles en este momento.
  </div>
  {{/if}}  --}}
</div>


<script src="/js/carrito.js"></script>

{{!-- se puede:
1. Crear un script de JavaScript para manejar el carrito de compras.
2. Vincular el motor de plantillas directamente a un archivo js.
3. Podemos usar JQUERY
--}}

{{!-- funcion de JQUERY para capturar el evento del botón --}}
<script src="https://cdn.jsdelivr.net/npm/jquery@4.0.0/dist/jquery.min.js"></script>
<script>
$(document).ready(function() {
  $('#carrito').click(function() {
    alert('Producto agregado al carrito');
  });
});
</script>